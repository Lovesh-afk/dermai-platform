# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
POSTGRES_USER=dermai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dermai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://dermai:change-me@db:5432/dermai

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Storage (Phase 4+) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# --- Chatbot (Phase 9) ---
# Free key: https://aistudio.google.com -> Get API key. Leave empty for
# knowledge-base-only answers. Check AI Studio for available model names.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Email (Phase 12) ---
# Leave SMTP_HOST empty to log emails instead of sending them.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-character app password, not your normal password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=DermAI <no-reply@dermai-platform.com>
FRONTEND_URL=http://localhost:3000

# --- Payments (Phase 13) ---
# Leave empty for a simulated checkout. Razorpay test keys: Dashboard ->
# Account & Settings -> API Keys (test mode). Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
